
<div id="<%= dom_id movie %>" class="movie-details">
  <div class="movie-detail-title">
    <h2><%= movie.title %></h2>
    <span class="rating-badge"><%= movie.rating.presence || "Not rated" %></span>
  </div>

  <div class="movie-detail-row">
    <span class="detail-label">Description</span>
    <p class="detail-value">
      <%= movie.description.presence || "No description available." %>
    </p>
  </div>

  <div class="movie-detail-row">
    <span class="detail-label">Release date</span>
    <p class="detail-value">
      <%= movie.release_date&.strftime("%B %-d, %Y at %-I:%M %p") || "Not specified" %>
    </p>
  </div>
</div>
