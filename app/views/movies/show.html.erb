<p class="notice-message"><%= notice %></p>

<div class="page-header">
  <h1>Movie Details</h1>
  <p class="page-subtitle">Explore the details of this movie.</p>
</div>

<div class="movie-details-card">
  <%= render @movie %>
</div>

<div class="page-actions movie-detail-actions">
  <%= link_to "Edit Movie", edit_movie_path(@movie), class: "button-link" %>
  <%= link_to "← Back to Movies", movies_path, class: "secondary-link" %>
  <%= button_to "Delete Movie", @movie, method: :delete,
      class: "danger-button",
      form: { class: "inline-form",
              data: { turbo_confirm: "Are you sure you want to delete this movie?" } } %>
</div>
